#API Gateway port
API_GATEWAY_PORT=8080

#Resource microservice
RESOURCE_SERVICE_PORT=8081
RESOURCE_SERVICE_URL=http://api-gateway:8080

#Song microservice
SONG_SERVICE_PORT=8082
SONG_SERVICE_URL=http://api-gateway:8080
SONG_SERVICE_HOST_PORT_RANGE=8082-8083
SONG_SERVICE_REPLICAS=1

POSTGRES_IMAGE=postgres:17-alpine3.24

#Resource db
RESOURCE_DB_NAME=resource-db
RESOURCE_DB_USER=postgres
RESOURCE_DB_PASSWORD=postgres
RESOURCE_DB_URL=jdbc:postgresql://resource-db:5432/resource-db
RESOURCE_DB_PORT=5432

#Song db
SONG_DB_NAME=song-db
SONG_DB_USER=postgres
SONG_DB_PASSWORD=postgres
SONG_DB_URL=jdbc:postgresql://song-db:5432/song-db
SONG_DB_PORT=5433

#Eureka
EUREKA_SERVER_PORT=8761
EUREKA_URL=http://eureka-server:8761/eureka/

#Resource processor
RESOURCE_PROCESSOR_SERVER_PORT=8085

#Local stack
LOCALSTACK_GATEWAY_HOST_PORT=4566
LOCALSTACK_SERVICES_HOST_PORT_RANGE=4510-4559
LOCALSTACK_HTTPS_HOST_PORT=443

AWS_ENDPOINT_URL=http://localstack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET=resource-bucket

#Rabbit MQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
RABBITMQ_USERNAME=app_user
RABBITMQ_PASSWORD=app_password

RESOURCE_UPLOADED_DESTINATION=resource-uploaded
RESOURCE_PROCESSOR_GROUP=resource-processor